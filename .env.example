# HTTP listen port
PORT=8080

# Application log level: debug, info, warn, or error
LOG_LEVEL=info

# SQLite database file
DB_PATH=./data/music-utils.db

# SQLite mmap size in bytes and page-cache size in KB (negative means KiB)
DB_MMAP_SIZE=536870912
DB_CACHE_SIZE_KB=-64000

# Maximum number of pooled SQLite connections
DB_MAX_OPEN_CONNS=16

# Per-client API rate limits
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_PER_MIN=180

# Only trust X-Forwarded-For when running behind a trusted proxy
TRUST_PROXY=false

# On local /api/get misses, query LRCLIB and cache successful results
LRCLIB_FALLBACK_ENABLED=true
LRCLIB_BASE_URL=https://lrclib.net/api
LRCLIB_USER_AGENT=music-utils/0.1 (+https://gru0.dev)
LRCLIB_TIMEOUT_MS=5000
