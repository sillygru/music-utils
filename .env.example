# HTTP listen port
PORT=8080

# Application log level: debug, info, warn, or error
LOG_LEVEL=info

# Independent SQLite database files. For an existing combined database, set
# METADATA_DB_PATH to the old file and LYRICS_DB_PATH to a new file for one
# startup migration.
METADATA_DB_PATH=./data/metadata.db
LYRICS_DB_PATH=./data/lyrics.db
COVER_DB_PATH=./data/cover.db

# SQLite mmap size in bytes and page-cache size in KB (negative means KiB)
DB_MMAP_SIZE=536870912
DB_CACHE_SIZE_KB=-64000

# Maximum number of pooled SQLite connections
DB_MAX_OPEN_CONNS=16

# Per-client API rate limits
RATE_LIMIT_PER_SEC=20
RATE_LIMIT_PER_MIN=600

# Per-client upstream budget: how many cache-missing requests may trigger
# provider fallback per minute per IP, so one client cannot monopolize the
# shared provider queue with garbage lookups.
FALLBACK_PER_MIN=60

# Maximum number of cache-missing requests waiting inside the upstream layer
# at once. When saturated, new misses fail fast with 503 instead of queueing.
FALLBACK_MAX_QUEUE=50

# How long a cache-missing request waits for a slot in the upstream queue
# before failing fast with 503. Keep it below the server write timeout.
FALLBACK_QUEUE_WAIT_MS=10000

# Only trust X-Forwarded-For when running behind a trusted proxy
TRUST_PROXY=false

# On local /api/lyrics/get misses, query LRCLIB and cache successful results
LRCLIB_FALLBACK_ENABLED=true
LRCLIB_BASE_URL=https://lrclib.net/api
LRCLIB_USER_AGENT=music-utils/v0.6.0 (+https://gru0.dev)
LRCLIB_TIMEOUT_MS=5000

# On local /api/metadata/get misses, query metadata providers in order
# (iTunes, then Deezer) and cache successful results. A cover URL is only kept
# when a provider includes one in its response for free.
METADATA_FALLBACK_ENABLED=true
ITUNES_BASE_URL=https://itunes.apple.com
DEEZER_BASE_URL=https://api.deezer.com
METADATA_USER_AGENT=music-utils/v0.6.0 (+https://gru0.dev)
METADATA_TIMEOUT_MS=5000

# On /api/cover/artist and /api/cover/album misses, resolve artwork from
# Last.fm, then iTunes, then Deezer, and cache the URL or checked-miss.
COVER_FALLBACK_ENABLED=true
COVER_USER_AGENT=music-utils/v0.6.0 (+https://gru0.dev)
COVER_TIMEOUT_MS=10000
LASTFM_BASE_URL=https://www.last.fm

# Background cover URL refresh. Cached positive rows older than
# COVER_REFRESH_AFTER_DAYS are revalidated (cheap range GET against the
# artwork CDN) only inside the local-time window START_HOUR..END_HOUR; rows
# whose URL is dead are re-resolved through the provider chain, capped per
# run. The job draws from the same provider pacing as live traffic.
COVER_REFRESH_ENABLED=true
COVER_REFRESH_AFTER_DAYS=30
COVER_REFRESH_START_HOUR=2
COVER_REFRESH_END_HOUR=5
COVER_REFRESH_MAX_ROWS=2000
COVER_REFRESH_MAX_RECHECK=200

# Background prefetch. After a song lookup succeeds (metadata, lyrics, or a
# song cover), the server quietly fetches and caches the song's lyrics, album
# cover, and artist cover in the background so later requests are local hits.
# Every target first checks the local caches and only spends upstream budget
# when something is genuinely missing; all calls flow through the same
# per-provider pacing as live traffic, and PREFETCH_PER_MIN caps how much
# background upstream spend may happen per minute (separate from client
# budgets). PREFETCH_CONCURRENCY bounds how many jobs run at once and
# PREFETCH_QUEUE_SIZE bounds the pending queue (jobs beyond it are dropped).
PREFETCH_ENABLED=true
PREFETCH_PER_MIN=10
PREFETCH_CONCURRENCY=4
PREFETCH_QUEUE_SIZE=64
PREFETCH_LYRICS=true
PREFETCH_ALBUM_COVER=true
PREFETCH_ARTIST_COVER=true

# Per-request access log. Every request is recorded (when, endpoint, params,
# status, cache/upstream outcome, and split timings) into a dedicated,
# storage-optimized SQLite database: integer timestamps, dictionary tables for
# repeated values, no secondary indexes, and incremental auto-vacuum. Rows
# older than REQUEST_LOG_RETENTION_DAYS are pruned daily (0 keeps everything).
# The request log is operational data: it is never served by the API and is
# never included in `music-utils export` dumps.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_DB_PATH=./data/request_log.db
REQUEST_LOG_RETENTION_DAYS=30
# Collapse well-known client User-Agents (curl, wget, browsers, ...) to short
# tokens in the request log to save storage; unknown agents then follow
# REQUEST_LOG_UA_SAVE_UNKNOWN (full, or dropped when false).
REQUEST_LOG_UA_OPTIMIZE=true
REQUEST_LOG_UA_SAVE_UNKNOWN=true
